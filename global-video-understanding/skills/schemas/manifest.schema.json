{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_id", "time_s", "path", "source_path", "sha256"],
      "properties": {
        "frame_id": {"type": "string", "minLength": 1}, "time_s": {"type": "number", "minimum": 0},
        "path": {"type": "string", "minLength": 1}, "source_path": {"type": "string", "minLength": 1},
        "sha256": {"pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "case_id", "frozen", "source_sha256", "scene_type", "probe", "global_frames", "critical_intervals", "interval_fallback", "batches", "packing"],
  "properties": {
    "schema_version": {"const": "1.0"}, "case_id": {"pattern": "^case_(?:[0-9a-f]{16}|[0-9]{8}T[0-9]{9}Z_[0-9a-f]{8})$"}, "frozen": {"const": true},
    "source_sha256": {"pattern": "^[0-9a-f]{64}$"}, "scene_type": {"enum": ["highway", "intersection"]},
    "probe": {"type": "object"}, "global_frames": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/frame"}},
    "critical_intervals": {"type": "array", "maxItems": 4}, "interval_fallback": {"type": "boolean"},
    "batches": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["batch_id", "start_s", "end_s", "frames", "packing"],
        "properties": {
          "batch_id": {"pattern": "^batch_[0-9]{4}$"}, "start_s": {"type": "number", "minimum": 0}, "end_s": {"type": "number", "exclusiveMinimum": 0},
          "frames": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/frame"}}, "packing": {"type": "object"}
        }
      }
    },
    "packing": {"type": "object"}
  }
}
