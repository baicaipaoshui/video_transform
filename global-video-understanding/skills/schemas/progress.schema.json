{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "phase", "status", "attempts", "sessions", "completed_batches", "error", "artifacts", "updated_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string"},
    "phase": {"enum": ["planning", "batching", "aggregating", "converting", "done", "failed"]},
    "status": {"enum": ["planning", "batching", "aggregating", "converting", "done", "done_degraded", "placeholder_generated", "needs_review", "failed"]},
    "attempts": {"type": "object"},
    "retry_epochs": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "execution_mode": {"enum": ["standard", "short_video_fast", "short_video_global"]},
    "substage": {"enum": ["batch_0001", "batch_0002", "batch_0003", "batch_0004", "reconciling", "behavior", "preview_review", "intersection_review", "world_closure", "building", "capability_gate", "conversion", "projection_gate", "render_verification"]},
    "generation_status": {"enum": ["done", "done_degraded", "placeholder_generated", "not_generated"]},
    "verification_level": {"enum": ["not_verified", "target_generated", "source_contract_validated", "render_verified"]},
    "source_contract_validation": {"enum": ["not_passed", "passed", "failed"]},
    "render_verification": {"enum": ["passed", "not_executed", "failed"]},
    "diagnostics": {"type": "object"},
    "retry_requested": {"type": "boolean"},
    "pipeline_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pipeline_fingerprint_at_creation": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "geometry_readjudications": {"type": "integer", "minimum": 0, "maximum": 1},
    "post_behavior_world_readjudications": {"type": "integer", "minimum": 0, "maximum": 1},
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "attempt", "session_id", "status"],
        "properties": {
          "stage": {"type": "string"},
          "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
          "session_id": {"type": "string"},
          "task_id": {"type": "string"},
          "retry_epoch": {"type": "integer", "minimum": 0},
          "error_code": {"type": "string"},
          "remote_error_code": {"type": "string"},
          "message": {"type": "string"},
          "candidate_exists": {"type": "boolean"},
          "invalid_candidate_path": {"type": "string", "minLength": 1},
          "consecutive_poll_errors": {"type": "integer", "minimum": 0},
          "last_poll_error": {"type": "string"},
          "last_poll_error_at": {"type": "string"},
          "last_polled_at": {"type": "string"},
          "recovered_from_poll_failure": {"type": "boolean"},
          "deadline_unix_s": {"type": "number"},
          "deadline_task_resolved": {"type": "boolean"},
          "recovered_from_task_failure": {"type": "boolean"},
          "candidate_validation_error": {"type": "string"},
          "validation_details": {"type": "object"},
          "rule_id": {"type": "string"},
          "actor_id": {"type": "string"},
          "telemetry": {"type": "object"},
          "output_file_size_bytes": {"type": "integer", "minimum": 0},
          "valid_parts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "missing_parts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "status": {"enum": ["submitted", "pending", "running", "returned", "completed", "invalid_output", "failed"]}
        }
      }
    },
    "completed_batches": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"pattern": "^batch_[0-9]{4}$"}},
    "checkpoint_errors": {"type": "array"},
    "error": {"type": ["object", "null"]},
    "artifacts": {"type": "object"},
    "updated_at": {"type": "string"},
    "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
