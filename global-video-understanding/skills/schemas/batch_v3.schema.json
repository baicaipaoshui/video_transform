{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": true,
      "properties": {
        "status": {"enum": ["observed", "estimated", "unknown"]},
        "frame_id": {"type": "string", "minLength": 1},
        "time_s": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "observed"}}}, "then": {"anyOf": [{"required": ["frame_id"]}, {"required": ["time_s"]}]}},
        {"if": {"properties": {"status": {"const": "estimated"}}}, "then": {"required": ["confidence"]}},
        {"if": {"properties": {"status": {"const": "unknown"}}}, "then": {"required": ["reason"]}}
      ]
    },
    "observation": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": true,
      "properties": {
        "answer_resolution": {"enum": ["confirmed", "needs_world_patch", "partial", "unknown"]},
        "conflict_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["observed", "estimated", "unknown"]},
        "frame_id": {"type": "string", "minLength": 1},
        "time_s": {"type": "number", "minimum": 0},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "observed"}}}, "then": {"anyOf": [
          {"required": ["frame_id"]},
          {"required": ["time_s"]},
          {"required": ["evidence"], "properties": {"evidence": {"minItems": 1, "contains": {"allOf": [{"$ref": "#/$defs/evidence"}, {"properties": {"status": {"const": "observed"}}}]}}}}
        ]}},
        {"if": {"properties": {"status": {"const": "estimated"}}}, "then": {"required": ["confidence"]}},
        {"if": {"properties": {"status": {"const": "unknown"}}}, "then": {"required": ["reason"]}}
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "case_id", "batch_id", "session_id", "world_evidence_epoch", "answered_question_ids", "observations", "semantic_conflicts", "registry_after"],
  "properties": {
    "contract_version": {"const": "video-case-world-behavior"},
    "case_id": {"pattern": "^case_(?:[0-9a-f]{16}|[0-9]{8}T[0-9]{9}Z_[0-9a-f]{8})$"},
    "batch_id": {"pattern": "^batch_[0-9]{4}$"},
    "session_id": {"type": "string", "minLength": 1},
    "world_evidence_epoch": {"type": "integer", "minimum": 1},
    "answered_question_ids": {"type": "array", "uniqueItems": true, "items": {"pattern": "^question_[0-9]{3,}$"}},
    "answered_ambiguity_ids": {"type": "array", "uniqueItems": true, "items": {"pattern": "^(?:ambiguity|amb)_[0-9]{3,}$"}},
    "vehicle_census": {"$ref": "vehicle_census.schema.json"},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "semantic_conflicts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "world_path", "proposed_value", "evidence", "impact_domains"], "properties": {"conflict_id": {"pattern": "^conflict_[A-Za-z0-9_-]+$"}, "world_path": {"type": "string", "pattern": "^world\\."}, "proposed_value": {}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "impact_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}},
    "registry_after": {"type": "array", "items": {"type": "object", "required": ["actor_id", "actor_type", "first_seen_frame_id", "identity_description"], "additionalProperties": true, "properties": {"actor_id": {"$ref": "actor_fields.schema.json#/$defs/actor_id"}, "actor_type": {"$ref": "actor_fields.schema.json#/$defs/actor_type"}, "vehicle_class": {"$ref": "actor_fields.schema.json#/$defs/vehicle_class"}, "identity_description": {"$ref": "actor_fields.schema.json#/$defs/identity_description"}, "first_seen_frame_id": {"$ref": "actor_fields.schema.json#/$defs/first_seen_frame_id"}, "hypothesized_lane": {"$ref": "actor_fields.schema.json#/$defs/lane_reference"}}}}
  }
}
