{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "case_id", "frozen", "source_sha256", "world_evidence_epoch", "n_zero", "n_zero_blockers", "interval_fallback", "global_frames", "batches"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "contract_version": {"const": "video-case-world-behavior"},
    "case_id": {"pattern": "^case_(?:[0-9a-f]{16}|[0-9]{8}T[0-9]{9}Z_[0-9a-f]{8})$"},
    "frozen": {"const": true},
    "source_sha256": {"pattern": "^[0-9a-f]{64}$"},
    "world_evidence_epoch": {"type": "integer", "minimum": 1},
    "world_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "n_zero": {"type": "boolean"},
    "n_zero_blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "interval_fallback": {"type": "boolean"},
    "global_frames": {"type": "array"},
    "planning_exclusions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["issue_id", "collection", "rule_id", "world_path", "evidence_frame_ids", "reason"],
      "properties": {
        "issue_id": {"type": "string", "minLength": 1},
        "collection": {"enum": ["questions_to_verify", "ambiguities"]},
        "rule_id": {"const": "batch.isolated_opposing_count.v1"},
        "world_path": {"const": "world.road.opposite_direction_lanes"},
        "evidence_frame_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "reason": {"type": "string", "minLength": 1}
      }
    }},
    "batches": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["batch_id", "start_s", "end_s", "assigned_question_ids", "world_evidence_epoch", "frames", "packing"], "properties": {"batch_id": {"pattern": "^batch_[0-9]{4}$"}, "start_s": {"type": "number", "minimum": 0}, "end_s": {"type": "number", "minimum": 0}, "assigned_question_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "assigned_ambiguity_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "world_evidence_epoch": {"type": "integer", "minimum": 1}, "world_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "frames": {"type": "array", "maxItems": 4}, "packing": {"type": "object"}}}}
  },
  "allOf": [{"if": {"properties": {"n_zero": {"const": true}}}, "then": {"properties": {"batches": {"maxItems": 0}, "n_zero_blockers": {"maxItems": 0}}}}]
}
