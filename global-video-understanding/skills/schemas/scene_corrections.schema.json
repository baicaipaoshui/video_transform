{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["revision", "parent_analysis_sha256", "reason"],
  "properties": {
    "revision": {"const": "user_scene_revision.v1"},
    "parent_analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "actor_lanes": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "actor_initial_gaps_m": {
      "description": "User-confirmed execution-only initial centre gaps ahead of ego; source trajectories remain unchanged.",
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^actor_[0-9]{3}$"},
      "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
    },
    "highway_layout": {
      "type": "object", "additionalProperties": false,
      "required": ["road_id", "driving_lane_count", "lane_remap", "right_parking_area"],
      "properties": {
        "road_id": {"type": "string", "minLength": 1},
        "driving_lane_count": {"type": "integer", "minimum": 1, "maximum": 6},
        "lane_remap": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"pattern": "^lane_[0-9]{3}$"},
          "additionalProperties": {"type": "string", "pattern": "^lane_[0-9]{3}$"}
        },
        "right_parking_area": {"type": "boolean"}
      }
    },
    "ego_entry_time_s": {"type": "number", "minimum": 0},
    "execution_duration_s": {"type": "number", "exclusiveMinimum": 0},
    "side_road_lane_counts": {
      "type": "object",
      "propertyNames": {"enum": ["road_002", "road_004"]},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count", "status", "confidence", "reason"],
        "properties": {
          "count": {"type": "integer", "minimum": 1, "maximum": 4},
          "status": {"const": "estimated"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "parked_vehicles": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["side", "x_m", "color", "vehicle_class"],
        "properties": {
          "side": {"enum": ["left", "right"]},
          "x_m": {"type": "number"},
          "color": {"type": "string", "minLength": 1},
          "vehicle_class": {"type": "string", "minLength": 1}
        }
      }
    },
    "reason": {"type": "string", "minLength": 1}
  }
}
