{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "input_hashes",
    "lane_knowledge",
    "limitation_bindings"
  ],
  "properties": {
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state/world_context.json",
        "state/behavior.json",
        "state/actor_registry.json"
      ],
      "properties": {
        "state/world_context.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state/behavior.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state/actor_registry.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "lane_knowledge": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "count",
          "anchors",
          "evidence_frame_ids"
        ],
        "properties": {
          "kind": {
            "enum": [
              "exact",
              "minimum",
              "unknown"
            ]
          },
          "count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lane_id",
                "ordinal_from_right",
                "evidence_frame_ids"
              ],
              "properties": {
                "lane_id": {
                  "type": "string"
                },
                "ordinal_from_right": {
                  "type": "integer",
                  "minimum": 0
                },
                "evidence_frame_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "evidence_frame_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "exact",
                    "minimum"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "count": {
                  "type": "integer"
                }
              }
            }
          }
        ]
      }
    },
    "limitation_bindings": {
      "type": "object",
      "additionalProperties": {
        "$ref": "limitation_binding.schema.json"
      }
    },
    "reason": {
      "type": "string"
    },
    "dependency_bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "road_id",
          "evidence_frame_ids",
          "side"
        ],
        "properties": {
          "kind": {
            "const": "unused_roadside_side"
          },
          "road_id": {
            "type": "string"
          },
          "evidence_frame_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "side": {
            "enum": [
              "left",
              "right"
            ]
          }
        }
      }
    }
  }
}
